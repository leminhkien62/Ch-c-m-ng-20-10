            function rs() {
                c.width = innerWidth; c.height = innerHeight;
                const ns = mobile ? 45 : 90;
                S = Array.from({ length: ns }, () => ({ x: Math.random() * c.width, y: Math.random() * c.height, r: Math.random() * 1.5 + .3, p: Math.random() * 6 }));
            }
            rs(); addEventListener("resize", rs);

            const COL = [[330, 90, 72], [290, 80, 78], [20, 95, 72], [48, 95, 70], [350, 85, 65], [200, 80, 78]];
            const back = t => { const c1 = 1.9, c3 = c1 + 1; return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2) };
            function mk() {
                const n = Math.max(mobile ? 5 : 8, Math.round(c.width / (mobile ? 80 : 70)));
                const sc = mobile ? .85 : 1;
                F = Array.from({ length: n }, (_, i) => ({
                    x: (i + .5) * c.width / n + (Math.random() - .5) * 30,
                    h: c.height * (.1 + Math.random() * (mobile ? .14 : .2)),
                    r: (16 + Math.random() * 14) * sc,
                    n: 6 + (i % 3) * 2, col: COL[i % COL.length], p: Math.random() * 6,
                    t0: 600 + i * 260, a: Math.random(), sp: .8 + Math.random() * .6
                }));
            }
            mk(); addEventListener("resize", mk);

            function petalShape(len, wd) { x.beginPath(); x.moveTo(0, 0); x.bezierCurveTo(wd, -len * .25, wd * .9, -len * .85, 0, -len); x.bezierCurveTo(-wd * .9, -len * .85, -wd, -len * .25, 0, 0) }
            function leaf(px, py, s, rot, sw) { x.save(); x.translate(px, py); x.rotate(rot + sw * .02); x.fillStyle = "#26c58a"; x.beginPath(); x.moveTo(0, 0); x.quadraticCurveTo(s * .6, -s * .5, s * 1.4, -s * .1); x.quadraticCurveTo(s * .6, s * .4, 0, 0); x.fill(); x.restore() }
            function layer(f, n, len, wd, rot, hue, l1, l2, al) {
                const [h, s] = f.col;
                for (let i = 0; i < n; i++) {
                    x.save(); x.rotate(rot + i * 6.2832 / n);
                    const g = x.createLinearGradient(0, 0, 0, -len);
                    g.addColorStop(0, `hsl(${h + hue},${s}%,${l1}%)`); g.addColorStop(1, `hsl(${h + hue},${s}%,${l2}%)`);
                    x.fillStyle = g; x.globalAlpha = al; petalShape(len, wd); x.fill();
                    x.strokeStyle = `hsla(${h},${s}%,95%,.35)`; x.lineWidth = .8; x.beginPath(); x.moveTo(0, -len * .15); x.lineTo(0, -len * .75); x.stroke(); x.restore();
                }
            }
            function flower(f, t) {
                const g = Math.min(1, (t - f.t0) / 2200); if (g <= 0) return;
                const H = c.height, sw = Math.sin(t / 1400 * f.sp + f.p) * 10 * g, ty = H - f.h * g, tx = f.x + sw;
                const sg = x.createLinearGradient(0, H, 0, ty); sg.addColorStop(0, "#128a62"); sg.addColorStop(1, "#3be0a2");
                x.globalAlpha = 1; x.strokeStyle = sg; x.lineWidth = 3.2; x.lineCap = "round"; x.beginPath(); x.moveTo(f.x, H); x.quadraticCurveTo(f.x, H - f.h * g * .5, tx, ty); x.stroke();
                const lx2 = f.x + (tx - f.x) * .3; leaf(lx2, H - f.h * g * .35, 14 * g, -.5, sw); leaf(lx2, H - f.h * g * .55, 11 * g, Math.PI + .5, sw);
                const b = Math.max(0, (g - .5) / .5); if (!b) return; const e = Math.min(1.08, back(b));
                x.save(); x.translate(tx, ty); x.rotate(sw / 55);
                const br = 1 + Math.sin(t / 500 * f.sp + f.p) * .05, sc = e * br; x.scale(sc, sc);
                const gl = x.createRadialGradient(0, 0, 0, 0, 0, f.r * 1.8); gl.addColorStop(0, `hsla(${f.col[0]},90%,75%,.35)`); gl.addColorStop(1, "transparent");
                x.globalAlpha = 1; x.fillStyle = gl; x.beginPath(); x.arc(0, 0, f.r * 1.8, 0, 7); x.fill();
                const spin = t / 7000 * (f.a > .5 ? 1 : -1);
                layer(f, f.n, f.r * 1.15, f.r * .42, spin, -12, 52, 82, .9);
                layer(f, f.n, f.r * .8, f.r * .34, spin * -1.6 + .4, 8, 62, 90, .95);
                const cg = x.createRadialGradient(0, 0, 0, 0, 0, f.r * .28); cg.addColorStop(0, "#fff3b0"); cg.addColorStop(1, "#ffb62e");
                x.fillStyle = cg;
                if (!mobile) { x.shadowColor = "#ffd34d"; x.shadowBlur = 12 }
                x.beginPath(); x.arc(0, 0, f.r * .26, 0, 7); x.fill(); x.shadowBlur = 0;
                x.fillStyle = "#c9791a"; for (let i = 0; i < 7; i++) { const a = i * 2.4, d = f.r * .13; x.beginPath(); x.arc(Math.cos(a) * d, Math.sin(a) * d, 1.3, 0, 7); x.fill() }
                x.restore();
                if (g >= 1) {
                    for (let i = 0; i < 3; i++) {
                        const a = t / 900 + f.p + i * 2.1, d = f.r * (1.5 + .3 * Math.sin(t / 400 + i)), kk = .5 + .5 * Math.sin(t / 300 + f.p * 3 + i * 2);
                        x.globalAlpha = kk; x.fillStyle = "#fff"; x.beginPath(); x.arc(tx + Math.cos(a) * d, ty + Math.sin(a) * d, 1.6 * kk + .4, 0, 7); x.fill();
                    }
                    x.globalAlpha = 1;
                }
            }

            function petal(px, py, burst) {
