@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0d0716">
    <title>20/10 · IT & IS VPIC1</title>
    <style>
        :root {
            --bg: #0d0716;
            --rose: #ff7eb6;
            --gold: #ffd89a;
            --lil: #c8a6ff;
            --tx: #fbeefa;
            box-sizing: border-box;
            color-scheme: dark
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent
        }

        html, body {
            height: 100%;
            height: 100dvh;
            overscroll-behavior: none
        }

        body {
            background: radial-gradient(ellipse at 50% 30%, #3a1752, #150a24 55%, #07040e);
            color: var(--tx);
            font-family: "Be Vietnam Pro", "Segoe UI", Arial, sans-serif;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            text-align: center;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px);
            -webkit-text-size-adjust: 100%
        }

        canvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none
        }

        header {
            position: relative;
            z-index: 3;
            padding: 16px 16px 0;
            width: 100%
        }

        .org {
            font-size: 12px;
            letter-spacing: .14em;
            color: var(--lil)
        }

        h1 {
            font-family: "Playfair Display", Georgia, serif;
            font-size: clamp(25px, 6.4vw, 60px);
            line-height: 1.2;
            margin: 6px auto 0;
            max-width: 900px;
            text-wrap: balance;
            background: linear-gradient(90deg, #fff, var(--rose), var(--lil), #fff);
            background-size: 250%;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: sh 6s linear infinite
        }

        @@keyframes sh {
            to {
                background-position: 250%
            }
        }

        .wish {
            min-height: 4.4em;
            margin: 8px auto 0;
            max-width: 560px;
            padding: 0 8px;
            font-size: clamp(13px, 2.4vw, 18px);
            line-height: 1.65;
            color: #f0dcf6;
            text-wrap: balance;
            transition: opacity .6s, transform .6s
        }

            .wish.out {
                opacity: 0;
                transform: translateY(8px)
            }

        .stage {
            position: relative;
            z-index: 2;
            width: 100%;
            flex: 1;
            min-height: 200px;
            perspective: 1100px;
            display: flex;
            align-items: center;
            justify-content: center;
            touch-action: pan-y;
            cursor: grab;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none
        }

            .stage:active {
                cursor: grabbing
            }

        .ring {
            position: relative;
            width: var(--cw, 140px);
            height: calc(var(--cw, 140px) * 1.32);
            transform-style: preserve-3d;
            will-change: transform
        }

        .card {
            position: absolute;
            inset: 0;
            border-radius: 14px;
            overflow: hidden;
            border: 2px solid #ffffff55;
            box-shadow: 0 0 22px #ff7eb655;
            background: #222;
            backface-visibility: visible;
            -webkit-backface-visibility: visible;
            transition: box-shadow .3s, border-color .3s
        }

            .card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                pointer-events: none;
                -webkit-user-drag: none;
                transition: transform .5s
            }

            .card::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(160deg, #ffffff30, transparent 40%)
            }

        @@media (hover: hover) {
            .card:hover {
                border-color: var(--gold);
                box-shadow: 0 0 40px #ffd89acc
            }

                .card:hover img {
                    transform: scale(1.15)
                }

            button:hover {
                transform: translateY(-2px)
            }
        }

        .hint {
            position: relative;
            z-index: 3;
            width: 100%;
            padding: 0 16px;
            font-size: 12px;
            color: #cdb9dc
        }

        footer {
            position: relative;
            z-index: 3;
            width: 100%;
            padding: 10px 16px 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px
        }

        button {
            font: inherit;
            font-size: 14px;
            color: #fff;
            border: 1px solid #ffffff66;
            border-radius: 30px;
            padding: 12px 24px;
            min-height: 44px;
            cursor: pointer;
            background: linear-gradient(135deg, #d34f9b, #8257c8);
            box-shadow: 0 0 24px #d34f9b66;
            transition: transform .2s;
            touch-action: manipulation
        }

            button:active {
                transform: scale(.97)
            }

            button:focus-visible, input:focus-visible {
                outline: 3px solid var(--gold);
                outline-offset: 3px
            }

        .sig {
            font-size: 12px;
            color: #cdb9dc;
            max-width: 520px;
            line-height: 1.5;
            text-wrap: balance
        }

            .sig b {
                color: var(--rose)
            }

        #lb {
            position: fixed;
            inset: 0;
            z-index: 50;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px;
            padding: 20px;
            background: #07040eee;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            opacity: 0;
            visibility: hidden;
            transition: .35s;
            cursor: zoom-out
        }

            #lb.on {
                opacity: 1;
                visibility: visible
            }

            #lb img {
                max-width: min(94vw, 900px);
                max-height: 72dvh;
                border-radius: 16px;
                border: 3px solid var(--gold);
                box-shadow: 0 0 60px #ff7eb699;
                transform: scale(.8) rotate(-2deg);
                transition: transform .5s cubic-bezier(.2, 1.3, .4, 1)
            }

            #lb.on img {
                transform: none
            }

            #lb p {
                font-size: clamp(14px, 3vw, 20px);
                color: var(--gold);
                text-align: center
            }

        /* ===== Lớp thiệp: chọn người -> phong bì ===== */
        #env {
            position: fixed;
            inset: 0;
            z-index: 60;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom));
            background: #07040ef5;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            overflow-y: auto;
            overflow-x: hidden;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
            opacity: 0;
            visibility: hidden;
            transition: opacity .4s, visibility .4s
        }

            /* canh giữa nhưng vẫn cuộn được khi nội dung dài (không bị cắt đầu) */
            #env > :first-child {
                margin-top: auto
            }

            #env > :last-child {
                margin-bottom: auto
            }

            #env.on {
                opacity: 1;
                visibility: visible
            }

        /* --- bước chọn người --- */
        #pick {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            max-width: 480px;
            width: 100%;
            text-align: center
        }

        #env[data-step=pick] #pick {
            display: flex
        }

        #env[data-step=pick] .eb, #env[data-step=pick] #eh, #env[data-step=pick] #envb {
            display: none
        }

        #env[data-step=letter] #pick {
            display: none
        }

        #pick h3 {
            font-family: "Playfair Display", Georgia, serif;
            font-size: clamp(20px, 5.4vw, 28px);
            color: var(--gold)
        }

        .grp {
            font-size: 12px;
            letter-spacing: .14em;
            color: var(--lil);
            margin-top: 8px
        }

        .chips {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            width: 100%
        }

        .chip {
            padding: 10px 16px;
            font-size: 14px;
            box-shadow: none;
            background: #ffffff14;
            border-color: #ffffff55
        }

            .chip:active {
                background: linear-gradient(135deg, #d34f9b, #8257c8)
            }

        @@media (hover: hover) {
            .chip:hover {
                background: linear-gradient(135deg, #d34f9b, #8257c8)
            }
        }

        .guest {
            display: flex;
            gap: 8px;
            width: 100%;
            max-width: 360px
        }

            .guest input {
                flex: 1;
                min-width: 0;
                font: inherit;
                font-size: 16px; /* >=16px để iOS không tự phóng to khi gõ */
                color: #fff;
                background: #ffffff14;
                border: 1px solid #ffffff55;
                border-radius: 30px;
                padding: 10px 16px;
                min-height: 44px
            }

                .guest input::placeholder {
                    color: #cdb9dc
                }

            .guest button {
                flex: none;
                padding: 10px 18px
            }

        /* --- phong bì --- */
        .eb {
            --w: min(88vw, 400px);
            --H: calc(var(--w) / 1.5);
            --lh: min(62dvh, 460px);
            position: relative;
            flex: none;
            width: var(--w);
            height: var(--H);
            margin-top: 0;
            cursor: pointer;
            transition: margin-top .7s ease
        }

            .eb.open {
                margin-top: max(0px, calc(var(--lh) - var(--H) * .94 + 8px))
            }

            .eb .back, .eb .front, .eb .flap {
                position: absolute;
                left: 0;
                width: 100%
            }

            .eb .back {
                inset: 0;
                background: #8c3a78;
                border-radius: 10px;
                box-shadow: 0 10px 50px #ff7eb655
            }

            .eb .front {
                top: 0;
                height: 100%;
                z-index: 3;
                border-radius: 10px;
                background: linear-gradient(135deg, #c8a6ff, #ff7eb6 55%, #e05a9c);
                clip-path: polygon(0 0, 50% 55%, 100% 0, 100% 100%, 0 100%)
            }

            .eb .flap {
                top: 0;
                height: 55%;
                z-index: 4;
                border-radius: 10px 10px 0 0;
                background: linear-gradient(#f4a0cf, #d86aaa);
                clip-path: polygon(0 0, 100% 0, 50% 100%);
                transform-origin: top;
                transition: transform .6s ease .05s, z-index 0s .3s
            }

            .eb.open .flap {
                transform: rotateX(180deg);
                z-index: 1
            }

        .seal {
            position: absolute;
            left: 50%;
            top: 55%;
            width: 50px;
            height: 50px;
            margin: -25px 0 0 -25px;
            border-radius: 50%;
            z-index: 6;
            display: grid;
            place-items: center;
            font-size: 24px;
            background: radial-gradient(circle at 35% 30%, #ffe9b5, #f0a93e);
            box-shadow: 0 3px 14px #0006;
            transition: opacity .3s, transform .4s;
            animation: pul 1.6s ease-in-out infinite
        }

        .eb.open .seal {
            opacity: 0;
            transform: scale(.4);
            animation: none
        }

        @@keyframes pul {
            50% {
                transform: scale(1.12)
            }
        }

        /* --- lá thư --- */
        .letter {
            position: absolute;
            left: 6%;
            width: 88%;
            bottom: 7%;
            height: 62%;
            z-index: 2;
            display: flex;
            flex-direction: column;
            gap: 10px;
            overflow-y: auto;
            overflow-x: hidden;
            padding: clamp(14px, 4vw, 26px) clamp(14px, 4.6vw, 30px);
            border-radius: 10px;
            color: #4a1d48;
            background: linear-gradient(#fff4fa, #f6e8ff);
            border: 2px solid #ffd89a;
            box-shadow: 0 4px 24px #ff7eb64d;
            font-family: "Be Vietnam Pro", "Segoe UI", Arial, sans-serif;
            transition: height .9s cubic-bezier(.3, 1.1, .4, 1) .45s;
            scrollbar-width: thin;
            scrollbar-color: #d86aaa #f6e8ff;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch
        }

            .letter::-webkit-scrollbar {
                width: 5px
            }

            .letter::-webkit-scrollbar-track {
                background: #f6e8ff;
                border-radius: 10px
            }

            .letter::-webkit-scrollbar-thumb {
                background: #d86aaa;
                border-radius: 10px
            }

        .eb.open .letter {
            height: var(--lh);
            bottom: 6%;
            z-index: 5
        }

        .lph {
            flex: none;
            align-self: center;
            width: 92px;
            height: 92px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid #ffd89a;
            box-shadow: 0 0 20px #ff7eb680;
            display: grid;
            place-items: center;
            font-size: 40px;
            background: #fde6f3
        }

            .lph img {
                width: 100%;
                height: 100%;
                object-fit: cover
            }

            .lph.none img {
                display: none
            }

        .letter h2 {
            font-family: "Playfair Display", Georgia, serif;
            font-size: clamp(17px, 4.6vw, 23px);
            line-height: 1.35;
            text-align: center;
            text-wrap: balance;
            color: #b0327a;
            padding-bottom: 12px;
            border-bottom: 1px solid #e6b8d6
        }

        .letter p {
            font-size: clamp(13px, 3.5vw, 15px);
            line-height: 1.75;
            text-align: left;
            text-wrap: pretty;
            overflow-wrap: break-word
        }

        .letter .to {
            margin-top: auto;
            padding-top: 6px;
            text-align: right;
            font-style: italic;
            color: #7b3fb5
        }

        .envhint {
            font-size: 13px;
            color: var(--gold);
            min-height: 1.4em;
            text-align: center;
            padding: 0 12px
        }

        .envbtns {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap
        }

            .envbtns button {
                padding: 9px 20px;
                font-size: 13px;
                background: transparent;
                box-shadow: none;
                opacity: .9
            }

        /* --- màn hình chào --- */
        #gate {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px;
            padding: 24px;
            text-align: center;
            background: radial-gradient(ellipse at 50% 35%, #3a1752, #150a24 60%, #07040e);
            transition: opacity .7s, visibility .7s
        }

            #gate.off {
                opacity: 0;
                visibility: hidden;
                pointer-events: none
            }

            #gate .gi {
                font-size: 56px
            }

            #gate h2 {
                font-family: "Playfair Display", Georgia, serif;
                font-size: clamp(26px, 7vw, 44px);
                background: linear-gradient(90deg, #fff, var(--rose), var(--lil));
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent
            }

            #gate p {
                max-width: 420px;
                line-height: 1.7;
                font-size: clamp(14px, 3.6vw, 17px);
                color: #f0dcf6
            }

            #gate button {
                margin-top: 8px;
                font-size: 16px;
                padding: 14px 28px
            }

        #mu {
            position: fixed;
            top: max(12px, env(safe-area-inset-top));
            right: 12px;
            z-index: 70;
            padding: 8px 14px;
            min-height: 40px;
            font-size: 13px
        }

        /* màn hình thấp (điện thoại ngang, máy nhỏ) */
        @@media (max-height: 640px) {
            .eb {
                --lh: min(56dvh, 460px)
            }

            #env {
                gap: 10px
            }

            header {
                padding-top: 10px
            }

            .wish {
                min-height: 3.4em
            }

            .lph {
                width: 64px;
                height: 64px;
                font-size: 28px
            }

            #gate .gi {
                font-size: 40px
            }
        }

        @@media (max-height: 520px) {
            .wish, .sig {
                display: none
            }

            .stage {
                min-height: 150px
            }
        }

        @@media (max-width: 480px) {
            .eb {
                --w: 92vw
            }

            .letter {
                left: 5%;
                width: 90%
            }

            .org {
                font-size: 11px
            }

            #mu {
                padding: 6px 12px
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            h1, .seal {
                animation: none
            }

            .eb, .eb .flap, .letter {
                transition-duration: .01s;
                transition-delay: 0s
            }
        }
    </style>
</head>

<body>
    <canvas id="c"></canvas>

    <audio id="bgm" loop preload="none" playsinline src="@Url.Content("~/content/ISIT/audio/nhac.mp3")"></audio>
    <button id="mu" type="button" aria-pressed="false">🔇 Bật nhạc</button>

    <div id="gate" role="dialog" aria-label="Màn hình chào">
        <div class="gi">🌸</div>
        <h2>Chúc mừng 20/10</h2>
        <p>Phòng IT & IS VPIC1 có một món quà nhỏ gửi các bạn.<br>Bật nhạc để bắt đầu nhé!</p>
        <button id="go" type="button">🎵 Bật nhạc &amp; vào xem</button>
    </div>

    <header>
        <div class="org">PHÒNG IT & IS · VPIC1</div>
        <h1>Chúc mừng ngày Phụ nữ Việt Nam 20/10</h1>
        <p class="wish" id="w"></p>
    </header>

    <div class="stage" id="s">
        <div class="ring" id="r"></div>
    </div>
    <div class="hint">Kéo ngang để xoay · chạm vào ảnh để xem lớn</div>

    <footer>
        <button id="b" type="button">💌 Mở thư chúc mừng 20/10</button>
        <div class="sig">Từ các anh em IT & IS với <b>♥</b> — chúc các bạn gái luôn rạng rỡ</div>
    </footer>

    <div id="lb" role="dialog" aria-label="Xem ảnh lớn">
        <img id="lbi" alt="Ảnh phóng to">
        <p>🌸 Chúc mừng 20/10 — phòng IT & IS VPIC1 🌷</p>
    </div>

    <div id="env" role="dialog" aria-label="Thiệp chúc mừng 20/10" data-step="pick">
        <div id="pick">
            <h3>Bạn là ai nhỉ? 🌸</h3>
            <div id="pl" style="width:100%"></div>
        </div>

        <div class="eb" id="eb" tabindex="0" role="button" aria-label="Bấm để mở phong bì">
            <div class="back"></div>
            <div class="letter" id="lt">
                <div class="lph" id="lph"><img id="lphi" alt="Ảnh chân dung"><span id="lphe">🌸</span></div>
                <h2 id="lh"></h2>
                <p id="l1"></p>
                <p id="l2"></p>
                <p id="l3"></p>
                <p class="to" id="lto">— Các anh em IT &amp; IS · VPIC1 —</p>
            </div>
            <div class="front"></div>
            <div class="flap"></div>
            <div class="seal">💖</div>
        </div>
        <div class="envhint" id="eh">Chạm vào phong bì để mở thiệp ✨</div>
        <div class="envbtns">
            <button id="envb" type="button">← Chọn lại</button>
            <button id="envx" type="button">Đóng</button>
        </div>
    </div>

    <script>
        (() => {
            const IMG_BASE = '@Url.Content("~/content/ISIT/images/")';
            const PB = '@Url.Content("~/content/ISIT/images/chandung/")';

            const IM = [1, 2, 3, 4, 5].map(i => IMG_BASE + "anh" + i + ".jpg");

            const W = [
                "Chúc các chị em phòng IT & IS luôn xinh đẹp, rạng rỡ như hoa mùa thu 🌸",
                "Cảm ơn các bạn đã làm cho đội ngũ VPIC1 thêm mạnh mẽ, ấm áp và nhiều tiếng cười 💖",
                "Chúc sức khỏe, hạnh phúc, bình an và luôn được yêu thương 🌷",
                "Không có bug nào đáng lo khi có các bạn ở đây — chúc 20/10 thật trọn vẹn ✨",
                "Chúc các bạn luôn tự tin tỏa sáng, thành công và may mắn trong mọi việc 💐"
            ];

            const mobile = matchMedia("(max-width:640px)").matches || matchMedia("(pointer:coarse)").matches;
            const rm = matchMedia("(prefers-reduced-motion:reduce)").matches;

            // ===== Canvas (khai báo sớm) =====
            const c = document.getElementById("c"), x = c.getContext("2d");
            let P = [], S = [], F = [];

            // ===== Vòng ảnh 3D =====
            const ring = document.getElementById("r"), st = document.getElementById("s"), N = 8;
            const cards = [];
            let R = 200;
            function size() {
                // cỡ thẻ theo màn hình, bán kính đủ lớn để các thẻ không chồng nhau
                const h = st.clientHeight || 260;
                const cw = Math.max(96, Math.min(innerWidth * .36, 190, (h - 24) / 1.32));
                R = Math.round(cw / (2 * Math.tan(Math.PI / N)) * 1.1);
                ring.style.setProperty("--cw", cw + "px");
                cards.forEach((d, i) => d.style.transform = `rotateY(${i * 360 / N}deg) translateZ(${R}px)`);
            }
            for (let i = 0; i < N; i++) {
                const d = document.createElement("div");
                d.className = "card";
                const im = new Image();
                im.decoding = "async";
                if (i > 0) im.loading = "lazy";
                im.src = IM[i % IM.length];
                im.alt = "Ảnh kỷ niệm phòng IT & IS";
                im.draggable = false;
                d.appendChild(im);
                ring.appendChild(d);
                cards.push(d);
            }
            size();
            addEventListener("resize", size);
            addEventListener("orientationchange", () => setTimeout(size, 250));

            let ang = 0, vel = .25, drag = false, lx = 0, tilt = 0, hov = false, sx = 0, dt = null;
            st.addEventListener("pointerover", e => { if (e.pointerType === "mouse") hov = !!e.target.closest(".card") });
