                    const o = ac.createOscillator(), g = ac.createGain(), t = ac.currentTime + t0;
                    o.type = type; o.frequency.value = f;
                    g.gain.setValueAtTime(0, t);
                    g.gain.linearRampToValueAtTime(v, t + .02);
                    g.gain.exponentialRampToValueAtTime(.001, t + d);
