            function choose(p) {
                setPhoto(p.img ? PB + p.img : null, "🌷");
                lh.textContent = `Gửi ${p.n} xinh đẹp của phòng ${p.g} 🌸`;
                l1.textContent = p.w[0]; l2.textContent = p.w[1]; l3.textContent = p.w[2];
                lto.textContent = "— Các anh em IT & IS · VPIC1 —";
                show();
            }
            function chooseGuest(raw) {
                const name = (raw || "").trim().replace(/\s+/g, " ");
                const who = name ? name : "bạn";
                const to = name ? name : "người bạn xinh đẹp";
                setPhoto(null, "💐");
                lh.textContent = `Gửi ${to} 🌸`;
                l1.textContent = `Nhân ngày Phụ nữ Việt Nam 20/10, tập thể anh em IT & IS xin gửi đến ${who} những lời chúc tốt đẹp và chân thành nhất. Cảm ơn ${who} đã luôn mang đến nguồn năng lượng tích cực và những nụ cười rạng rỡ cho mọi người xung quanh.`;
                l2.textContent = `Chúc ${who} luôn xinh đẹp, tự tin, mạnh khỏe và hạnh phúc; công việc thuận lợi, cuộc sống ngập tràn niềm vui và luôn được yêu thương, trân trọng. Mong mọi ước mơ của ${who} đều sớm trở thành hiện thực.`;
                l3.textContent = `Đặc biệt, chúc ${who} luôn gặp nhiều may mắn, tình yêu luôn "không lỗi hệ thống", hạnh phúc luôn "online" và mọi điều tốt đẹp đều được "deploy" thành công! 💐`;
                lto.textContent = "— Phòng IT & IS · VPIC1 —";
                show();
            }

            // ===== Phong bì =====
            function openEnv() { env.dataset.step = "pick"; env.classList.add("on"); eb.classList.remove("open"); env.scrollTop = 0 }
            function toggleEnv() {
                const o = eb.classList.toggle("open");
                eh.textContent = o ? "Chúc một ngày 20/10 thật ngọt ngào 🌷" : "Chạm vào phong bì để mở thiệp ✨";
                if (o) { chime(); for (let i = 0; i < (mobile ? 30 : 60); i++) petal(c.width / 2, c.height * .75, true) }
            }
            function closeEnv() { env.classList.remove("on"); eb.classList.remove("open"); env.dataset.step = "pick" }
            document.getElementById("b").onclick = openEnv;
            document.getElementById("envb").onclick = () => { eb.classList.remove("open"); env.dataset.step = "pick"; env.scrollTop = 0 };
            eb.onclick = e => { if (e.target.closest(".letter") && eb.classList.contains("open")) return; toggleEnv() };
            eb.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggleEnv() } });
            document.getElementById("envx").onclick = closeEnv;
            addEventListener("keydown", e => { if (e.key === "Escape") { lb.classList.remove("on"); closeEnv() } });
        })();
    </script>
</body>

</html>
